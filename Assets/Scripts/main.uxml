<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="Header" style="flex-grow: 0;">
        <ui:Label text="Smart Farm" name="Title" style="font-size: 50px; -unity-font-style: bold; margin-bottom: 20px;"/>
    </ui:VisualElement>
    <ui:VisualElement name="Body" style="flex-grow: 1; flex-direction: row;">
        <ui:VisualElement name="TemperatureSection" style="flex-grow: 1;">
            <ui:Label text="Temperature (°C)" name="Temperature" style="font-size: 30px;"/>
            <ui:Label text="temperature value" name="TemperatureValue" style="font-size: 30px;"/>
            <ui:ProgressBar value="22" title="" name="TemperatureLevel"/>
        </ui:VisualElement>
        <ui:VisualElement name="HumiditySection" style="flex-grow: 1;">
            <ui:Label text="Humidity (%)" name="Humidity" style="font-size: 30px;"/>
            <ui:Label text="humidity value" name="HumidityValue" style="font-size: 30px;"/>
            <ui:ProgressBar value="22" title="" name="HumidityLevel"/>
        </ui:VisualElement>
        <ui:VisualElement name="IlluminanceSection" style="flex-grow: 1;">
            <ui:Label text="Illuminance" name="Illuminance" style="font-size: 30px;"/>
            <ui:Label text="illuminance value" name="IlluminanceValue" style="font-size: 30px;"/>
            <ui:ProgressBar value="22" title="" name="IlluminanceLevel"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
